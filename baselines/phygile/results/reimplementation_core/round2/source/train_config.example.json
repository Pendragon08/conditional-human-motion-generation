{
  "purpose": "research_training",
  "assumptions": "Proposed independent settings, not the unpublished author training configuration. Requires genuine paired 262D robot/text inputs. ASFO mirroring is not implemented.",
  "dataset_manifest": "/replace/with/verified/dataset_manifest.json",
